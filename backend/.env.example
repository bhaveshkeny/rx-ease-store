SECRET_KEY=replace-with-a-long-random-secret
# PostgreSQL connection URL. Use the internal/private URL when your host provides one.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/pharmacy
# Vercel Postgres integrations usually provide POSTGRES_URL_NON_POOLING or POSTGRES_URL.
# DATABASE_URL takes precedence when all are present.
# Comma-separated browser origins. Do not include paths; trailing slashes are optional.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
